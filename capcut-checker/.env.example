# Copy file này thành .env rồi điền key thật
# cp .env.example .env

# ═══ SELLTAIKHOAN ═══
# API key selltaikhoan (lấy ở selltaikhoan.com → API)
SELLTK_API_KEY=
# ID sản phẩm mail (vd 6762 = Outlook OAuth2 80đ). Chạy: node -e "..." để xem danh sách
SELLTK_PRODUCT=

# ═══ CAPCUT TEAM ═══
# Link mời vào team (dạng https://www.capcut.com/sv2/...). Bỏ trống = không join
TEAM_INVITE_LINK=

# ═══ PROXY MKTPROXY ═══
# Nhiều key proxy xoay: phân cách bằng dấu phẩy, script tự round-robin
MKT_PROXY_KEYS=key1,key2,key3
# Xoay IP mỗi account (true/false)
ROTATE_EACH=true

# ═══ CHUNG ═══
# Mode: register (mua mail+check) | check (login+info) | join (login+join team)
MODE=check
# Số account cần tạo (mode=register)
COUNT=5
# Nghỉ giữa mỗi account (ms)
DELAY_MS=3000
# File input/output
INPUT_FILE=accounts.txt
OUTPUT_FILE=results.txt
